<title>Painel Blitz de Segurança</title>
<style>
:root{--navy:#071b34;--blue:#0d4f88;--blue2:#1769aa;--bg:#eef3f8;--card:#fff;--green:#168447;--red:#c43b3b;--amber:#c78200;--text:#162536}
*{box-sizing:border-box}body{margin:0;font-family:Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--text)}
header{background:linear-gradient(135deg,var(--navy),var(--blue));color:#fff;padding:28px 5%;box-shadow:0 3px 15px #0003}
header h1{margin:0;font-size:30px}header p{opacity:.85;margin:7px 0 0}
main{max-width:1500px;margin:auto;padding:24px}.cards{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
.card{background:#fff;border-radius:14px;padding:18px;box-shadow:0 3px 14px #16324a16}.card b{font-size:27px;display:block;margin-top:8px}
.panel{background:#fff;margin-top:18px;border-radius:14px;padding:18px;box-shadow:0 3px 14px #16324a16}
.controls{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}input,select,button{border:1px solid #ccd6e0;border-radius:8px;padding:10px 12px;background:#fff}
input{min-width:280px}button{background:var(--blue);color:white;border:0;cursor:pointer}
table{width:100%;border-collapse:collapse;font-size:13px}th{position:sticky;top:0;background:var(--navy);color:#fff;text-align:left;padding:10px}td{padding:9px;border-bottom:1px solid #e7edf3;vertical-align:top}
.badge{display:inline-block;padding:4px 8px;border-radius:20px;font-weight:700;font-size:11px}.ok{background:#dcf3e5;color:var(--green)}.nok{background:#fde1e1;color:var(--red)}.wait{background:#fff0cf;color:var(--amber)}.yes{background:#dfeeff;color:var(--blue)}
.tabs{display:flex;gap:8px;margin-bottom:14px}.tabs button.active{background:var(--navy)}.hidden{display:none}.small{font-size:12px;color:#617386}
@media(max-width:900px){.cards{grid-template-columns:1fr 1fr}table{min-width:1100px}.tablewrap{overflow:auto}}

.recurrence-ranking h2{margin:0 0 5px;font-size:21px;color:var(--navy)}
.section-head{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-bottom:18px}
.section-head p{margin:0;color:#617386}
.metric{text-align:right;min-width:160px}.metric b{display:block;font-size:30px;color:var(--blue)}.metric span{font-size:12px;color:#617386}
.rank-legend{display:grid;grid-template-columns:minmax(280px,1.3fr) 2fr;gap:15px;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#718295;font-weight:700;margin:0 45px 8px}
.rank-row{display:grid;grid-template-columns:32px minmax(280px,1.3fr) 2fr 38px;gap:12px;align-items:center;padding:9px 0;border-top:1px solid #edf1f5}
.rank-pos{font-weight:800;color:var(--blue);text-align:center}.rank-name{min-width:0}.rank-name strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rank-name span{display:block;font-size:11px;color:#718295;margin-top:2px}
.bar-track{height:18px;background:#edf2f6;border-radius:10px;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,#1769aa,#0d4f88);border-radius:10px}.rank-value{font-size:16px;font-weight:800;color:var(--navy);text-align:center}
@media(max-width:760px){.section-head{align-items:flex-start;flex-direction:column}.metric{text-align:left}.rank-legend{display:none}.rank-row{grid-template-columns:28px minmax(150px,1fr) 1.2fr 30px;gap:7px}.rank-name span{white-space:normal}.bar-track{height:14px}}
</style></head>
