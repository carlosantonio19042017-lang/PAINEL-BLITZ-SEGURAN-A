function renderRec(){recBody.innerHTML=DATA.recurrence.map(x=>`<tr><td>${esc(x.colaborador)}</td><td>${esc(x.modal)}</td><td>${esc(x.placa)}</td><td>${esc(x.item)}</td><td>${x.meses}<div class="small">${esc(x.meses_txt)}</div></td><td>${badge(x.considera)}</td><td>${badge(x.recorrente)}</td><td>${badge(x.status)}</td></tr>`).join('')}
function renderModal(){let mods=['CARRO','MOTO','BICICLETA'];modalCards.innerHTML=mods.map(m=>{let a=DATA.summary.filter(x=>x.modal===m);let done=a.filter(x=>x.blitz_mes==='REALIZADA').length;return `<div class="card"><strong>${m}</strong><b>${a.length}</b><span class="small">colaboradores • ${done} Blitz realizadas no mês • ${a.length-done} pendentes</span></div>`}).join('')}
